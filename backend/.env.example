APP_ENV=development
APP_DEBUG=false
DATABASE_TARGET=local
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/cm_kerala
SUPABASE_DATABASE_URL=
# Optional absolute path to a privately supplied trusted CA; default uses certifi.
# SUPABASE_SSLROOTCERT=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=cm-kerala-grievance-api
JWT_AUDIENCE=cm-kerala-grievance-client
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=cmk_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_PATH=/api/v1/auth
DEFAULT_RESOLUTION_DAYS=14
GEMINI_API_KEY=
AI_ENABLED=false
AI_LIVE_REQUESTS_ENABLED=false
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=0
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_INPUT_CHARACTERS=50000
AI_DUPLICATE_CANDIDATE_LIMIT=5
AI_DUPLICATE_SIMILARITY_THRESHOLD=0.75
AI_REQUESTS_PER_MINUTE=5
AI_CACHE_SECONDS=60
SUPABASE_URL=
SUPABASE_STORAGE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=grievance-attachments
ATTACHMENT_MAX_SIZE_MB=5
ATTACHMENT_MAX_FILES_PER_GRIEVANCE=5
ATTACHMENT_SIGNED_URL_SECONDS=60
CONTACT_REQUESTS_PER_HOUR=5
# Local-only demo seeder; never populate these in committed examples.
SEED_CITIZEN_PASSWORD=
SEED_CMO_PASSWORD=
SEED_OFFICER_PASSWORD=
# Dedicated EMPTY loopback PostgreSQL database; fixtures mutate its schema.
# TEST_DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/cm_kerala_test
# Optional development identity guard: explicitly supply BOTH for ai_runtime/readiness.
# EXPECTED_SUPABASE_PROJECT=
# EXPECTED_TARGET_FINGERPRINT=
